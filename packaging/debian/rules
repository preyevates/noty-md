#!/usr/bin/make -f
# Fan Fold Debian packaging.
#
# The upstream tree is a plain CMake project that already installs to correct FHS
# locations under CMAKE_INSTALL_PREFIX (binary in bin, assets in share/fanfold,
# desktop entry and icons in the XDG locations). debhelper's cmake buildsystem
# therefore needs no override beyond the two points below.

export DH_VERBOSE = 1

%:
	dh $@ --buildsystem=cmake

# BUILD_TESTING is off: the upstream CTest suite is the qualification gate run
# against the source candidate, not a packaging step. Enabling it here would add
# Qt6::Test, Xvfb and Python build dependencies to produce no packaged artifact.
#
# FANFOLD_LOCAL_THEME_CATALOG_DIR is deliberately left empty. That is upstream's
# public-package default and keeps the uncleared TerminalColors catalog out of
# every published artifact.
# The packaged revision is taken from the changelog dpkg is already building from,
# so Settings -> About reports the version the user actually installed rather than a
# constant somebody has to remember to bump.
DEB_VERSION := $(shell dpkg-parsechangelog -SVersion)

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=OFF \
		-DFANFOLD_BUILD_VERSION="$(DEB_VERSION)" \
		-DFANFOLD_LOCAL_THEME_CATALOG_DIR=

# Software-centre catalogue. KDE Discover (6.6, with KIconThemes 6.24) shows only a
# placeholder for a package whose AppStream data offers nothing but a stock icon: its
# stock-icon check compares the bare icon name against a list of full icon paths, so it
# never matches. It does honour "cached" icons, which come from a compiled catalogue in
# /usr/share/swcatalog, the same place Ubuntu's own archive catalogue and vendor packages
# such as ChatGPT put theirs. appstreamcli compose builds that catalogue from the
# metainfo, desktop entry and hicolor icons this package has just staged, so the listing
# and its icons cannot drift from what is installed. --no-net keeps the build offline;
# the origin names the catalogue, which AppStream otherwise leaves unset.
SWCATALOG_ROOT := debian/fanfold
SWCATALOG_WORK := debian/swcatalog-compose

execute_after_dh_auto_install:
	rm -rf $(SWCATALOG_WORK)
	appstreamcli compose --no-net --origin=fanfold --prefix=/usr \
		--data-dir=$(SWCATALOG_WORK)/xml \
		--icons-dir=$(SWCATALOG_WORK)/icons \
		--hints-dir=$(SWCATALOG_WORK)/hints \
		$(SWCATALOG_ROOT)
	test -s $(SWCATALOG_WORK)/xml/fanfold.xml.gz
	zcat $(SWCATALOG_WORK)/xml/fanfold.xml.gz \
		| sed '0,/<components version="\([^"]*\)">/s//<components version="\1" origin="fanfold">/' \
		| gzip -9n > $(SWCATALOG_WORK)/fanfold.xml.gz
	zcat $(SWCATALOG_WORK)/fanfold.xml.gz | grep -q '<components [^>]*origin="fanfold"'
	zcat $(SWCATALOG_WORK)/fanfold.xml.gz | grep -q '<icon type="cached"'
	install -D -m 0644 $(SWCATALOG_WORK)/fanfold.xml.gz \
		$(SWCATALOG_ROOT)/usr/share/swcatalog/xml/fanfold.xml.gz
	mkdir -p $(SWCATALOG_ROOT)/usr/share/swcatalog/icons/fanfold
	cp -r $(SWCATALOG_WORK)/icons/. $(SWCATALOG_ROOT)/usr/share/swcatalog/icons/fanfold/
	rm -rf $(SWCATALOG_WORK)

# QtWebEngine and QtWebChannel are QML imports resolved at runtime, not linked
# libraries, so dpkg-shlibdeps cannot see them; they are declared by hand in
# debian/control alongside the other qml6-module-* imports. Everything the ELF
# actually links is derived by the default dh_shlibdeps into ${shlibs:Depends}.
